{
  "name": "policy-pulse-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vue 3 frontend for Policy Pulse, on top of the HTTP API in app/api",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "gen:api": "openapi-typescript ${API_URL:-http://127.0.0.1:8000}/api/openapi.json -o src/api/schema.d.ts",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@tanstack/vue-query": "^5.104.5",
    "d3-cloud": "^1.2.9",
    "d3-geo": "^3.1.1",
    "echarts": "^6.1.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "openapi-fetch": "^0.17.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/d3-cloud": "^1.2.9",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
