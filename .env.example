# MongoDB connection for the app. Copy to .env.
#
# For local development you don't need to do this by hand: `uv run init-env` writes this file for
# you and starts a local MongoDB (see README, "Local database"). The local database needs no
# credentials; a production URI carries the user and password, which are a real secret and never
# live in the repo.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=policy_pulse

# Optional. How often (seconds) each app process checks MongoDB for a newer successful
# ingestion run and rebuilds its in-memory data. Default 1800 (30 min); 0 disables reloading,
# which is what you want if you are poking at the database by hand and don't want the app
# rebuilding underneath you.
#RELOAD_INTERVAL_SECONDS=1800
