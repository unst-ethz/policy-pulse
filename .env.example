# Public interface is loopback by default, behind the deployment's HTTPS reverse proxy.
POLICY_PULSE_BIND=127.0.0.1
POLICY_PULSE_PORT=8050
# Pin both images to the SAME tested commit tag (or immutable digests) for releases.
# POLICY_PULSE_BACKEND_IMAGE=ghcr.io/unst-ethz/policy-pulse/backend:COMMIT_SHA
# POLICY_PULSE_FRONTEND_IMAGE=ghcr.io/unst-ethz/policy-pulse/frontend:COMMIT_SHA
# Native development defaults:
# POLICY_PULSE_DATA_DIR=/absolute/path/to/policy-pulse/data
# POLICY_PULSE_LOG_DIR=/absolute/path/to/policy-pulse/logs
# POLICY_PULSE_CONFIG=/absolute/path/to/config/data_sources.yaml
# POLICY_PULSE_CORS_ORIGINS=http://localhost:5173
