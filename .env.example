# Postgres connection for the app. Copy to .env and fill in PGPASSWORD.
#
# For local development you don't need to do this by hand: `uv run init-env` writes this file for
# you and starts a Postgres holding a copy of the production data (see README, "Local database").
# The local dev password is `policy_pulse`; it is left blank here because the same file describes
# the production connection, whose password is a real secret and never lives in the repo.
PGHOST=localhost
PGPORT=5432
PGDATABASE=policy_pulse
PGUSER=policy_pulse
PGPASSWORD=

# Optional. How often (seconds) each app process checks Postgres for a newer successful
# ingestion run and rebuilds its in-memory data. Default 1800 (30 min); 0 disables reloading,
# which is what you want if you are poking at the database by hand and don't want the app
# rebuilding underneath you.
#RELOAD_INTERVAL_SECONDS=1800
